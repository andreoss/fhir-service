{
  "realm": "fhir",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "defaultSignatureAlgorithm": "RS256",
  "clientScopes": [
    {
      "name": "launch",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "launch/patient",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "patient context",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "patient",
            "claim.name": "patient",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "patient/*.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "user/*.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "system/*.rs",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "fhirUser",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "fhir user",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "fhirUser",
            "claim.name": "fhirUser",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultOptionalClientScopes": [
    "launch",
    "launch/patient",
    "patient/*.rs",
    "user/*.rs",
    "system/*.rs",
    "fhirUser"
  ],
  "clients": [
    {
      "clientId": "smart-app",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "smart-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "optionalClientScopes": [
        "launch",
        "launch/patient",
        "patient/*.rs",
        "user/*.rs",
        "system/*.rs",
        "fhirUser"
      ]
    },
    {
      "clientId": "inferno",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "optionalClientScopes": [
        "launch",
        "launch/patient",
        "patient/*.rs",
        "user/*.rs",
        "system/*.rs",
        "fhirUser"
      ]
    },
    {
      "clientId": "inferno-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-jwt",
      "attributes": {
        "use.jwks.string": "true",
        "jwks.string": "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-384\",\"x\":\"JQKTsV6PT5Szf4QtDA1qrs0EJ1pbimQmM2SKvzOlIAqlph3h1OHmZ2i7MXahIF2C\",\"y\":\"bRWWQRJBgDa6CTgwofYrHjVGcO-A7WNEnu4oJA5OUJPPPpczgx1g2NsfinK-D2Rw\",\"use\":\"sig\",\"key_ops\":[\"verify\"],\"ext\":true,\"kid\":\"4b49a739d1eb115b3225f4cf9beb6d1b\",\"alg\":\"ES384\"},{\"kty\":\"RSA\",\"alg\":\"RS384\",\"n\":\"vjbIzTqiY8K8zApeNng5ekNNIxJfXAue9BjoMrZ9Qy9m7yIA-tf6muEupEXWhq70tC7vIGLqJJ4O8m7yiH8H2qklX2mCAMg3xG3nbykY2X7JXtW9P8VIdG0sAMt5aZQnUGCgSS3n0qaooGn2LUlTGIR88Qi-4Nrao9_3Ki3UCiICeCiAE224jGCg0OlQU6qj2gEB3o-DWJFlG_dz1y-Mxo5ivaeM0vWuodjDrp-aiabJcSF_dx26sdC9dZdBKXFDq0t19I9S9AyGpGDJwzGRtWHY6LsskNHLvo8Zb5AsJ9eRZKpnh30SYBZI9WHtzU85M9WQqdScR69Vyp-6Uhfbvw\",\"e\":\"AQAB\",\"use\":\"sig\",\"key_ops\":[\"verify\"],\"ext\":true,\"kid\":\"b41528b6f37a9500edb8a905a595bdd7\"}]}",
        "token.endpoint.auth.signing.alg": "ES384"
      },
      "optionalClientScopes": [
        "system/*.rs"
      ]
    }
  ],
  "users": [
    {
      "username": "app-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "App",
      "lastName": "User",
      "attributes": {
        "patient": "example",
        "fhirUser": "Patient/example"
      },
      "credentials": [
        {
          "type": "password",
          "value": "app-secret",
          "temporary": false
        }
      ]
    }
  ]
}
